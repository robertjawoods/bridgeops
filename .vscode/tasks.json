{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Railway: Postgres Tunnel + Prisma Env Sync",
			"type": "shell",
			"icon": {
				"id": "database",
				"color": "terminal.ansiMagenta"
			},
			"command": "bash scripts/railway-prisma-tunnel.sh",
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"group": "bridgeops-stack",
				"panel": "dedicated",
				"clear": false
			},
			"problemMatcher": [
				{
					"owner": "custom",
					"fileLocation": ["relative", "${workspaceFolder}"],
					"pattern": {
						"regexp": "^(?:\\[ERR\\]|ERR|ERROR|Error|FAIL|Failed)[:\\s]+(.+)$",
						"message": 1
					},
					"background": {
						"activeOnStart": true,
						"beginsPattern": "^Starting Railway Postgres tunnel$",
						"endsPattern": "^Prisma DATABASE_URL updated:.*$"
					}
				}
			]
		},
		{
			"label": "Dev: pnpm dev",
			"type": "shell",
			"icon": {
				"id": "rocket",
				"color": "terminal.ansiGreen"
			},
			"command": "pnpm dev",
			"isBackground": true,
			"dependsOn": ["Railway: Postgres Tunnel + Prisma Env Sync"],
			"dependsOrder": "sequence",
			"presentation": {
				"reveal": "always",
				"group": "bridgeops-stack",
				"panel": "dedicated",
				"clear": false
			}
		},
		{
			"label": "Tunnel: ngrok 5173",
			"type": "shell",
			"icon": {
				"id": "globe",
				"color": "terminal.ansiCyan"
			},
			"command": "ngrok http --url=zeke-monohydroxy-unscrupulously.ngrok-free.dev 5173",
			"isBackground": true,
			"dependsOn": ["Railway: Postgres Tunnel + Prisma Env Sync"],
			"dependsOrder": "sequence",
			"presentation": {
				"reveal": "always",
				"group": "bridgeops-stack",
				"panel": "dedicated",
				"clear": false
			}
		},
		{
			"label": "Run: BridgeOps Local Stack",
			"type": "shell",
			"icon": {
				"id": "play-circle",
				"color": "terminal.ansiBlue"
			},
			"command": "echo Starting BridgeOps local stack",
			"dependsOn": ["Dev: pnpm dev", "Tunnel: ngrok 5173"],
			"dependsOrder": "parallel",
			"problemMatcher": []
		}
	]
}
