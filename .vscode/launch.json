{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch SvelteKit",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": ["dev", "--inspect"],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/apps/web/.svelte-kit/**/*.js"
            ],
            "sourceMaps": true
        }
    ]
}