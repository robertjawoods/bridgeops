{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
  },
  "exclude": ["node_modules", "src/**/*.test.ts"],
  "include": ["env.d.ts", "src/**/*.ts"]
}
