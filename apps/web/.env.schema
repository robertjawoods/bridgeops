# SvelteKit app config.
# @import(../../packages/database/, pick=[DATABASE_URL])
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=./env.d.ts)
# @plugin(@varlock/infisical-plugin)
# @initInfisical(
#   projectId=60d63c77-06bf-4587-a955-b487bbac1026,
#   environment=dev,
#   clientId=$INFISICAL_CLIENT_ID,
#   clientSecret=$INFISICAL_CLIENT_SECRET
# )
# ---

# Infisical credentials are supplied by the local environment or secret provider.
# @type=infisicalClientId
INFISICAL_CLIENT_ID=

# @type=infisicalClientSecret
# @sensitive
# @internal
INFISICAL_CLIENT_SECRET=

# Public app origin used by Better Auth when constructing absolute URLs.
# @required=false
# @type=url
ORIGIN=

# Better Auth secret for signing sessions and tokens.
# @sensitive
BETTER_AUTH_SECRET=infisical()

# GitHub OAuth app credentials.
GITHUB_CLIENT_ID=infisical()

# GitHub OAuth app secret.
# @sensitive
GITHUB_CLIENT_SECRET=infisical()

# Resend API key for verification emails.
# @sensitive
RESEND_KEY=infisical()

# Better Auth dashboard / infra API key.
# @sensitive
BETTER_AUTH_API_KEY=infisical()

GOOGLE_CLIENT_ID=infisical()

# @sensitive
GOOGLE_CLIENT_SECRET=infisical()

# @type=email
# @required
EMAIL_ADDRESS=
